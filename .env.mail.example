# SERVER ONLY: set in Netlify environment variables, never www/config.js.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-in-host-settings
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAIL_ENCRYPTION_KEY=replace-with-32-random-bytes-in-base64
# Use cPanel > Email Accounts > Connect Devices > Secure SSL/TLS Settings.
MAIL_IMAP_HOST=your-cpanel-secure-mail-hostname
MAIL_SMTP_HOST=your-cpanel-secure-mail-hostname
MAIL_SMTP_PORT=465
MAIL_ALLOWED_DOMAINS=your-company-domain.com
# Optional overrides only if server special-use folder discovery differs.
# MAIL_FOLDER_SENT=INBOX.Sent
# MAIL_FOLDER_TRASH=INBOX.Trash
# MAIL_FOLDER_ARCHIVE=INBOX.Archive
# MAIL_FOLDER_SPAM=INBOX.Junk
# Generate a pair: npx web-push generate-vapid-keys
MAIL_VAPID_PUBLIC_KEY=replace-public-key
MAIL_VAPID_PRIVATE_KEY=replace-private-key
MAIL_VAPID_SUBJECT=mailto:your-email-administrator@your-company-domain.com
# Website sourcing form → Leads + Sourcing (see supabase/website-intake-v8.sql).
# Same value goes into the website's Laravel .env as HC_INTAKE_SECRET.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBSITE_INTAKE_SECRET=replace-with-64-hex-characters
