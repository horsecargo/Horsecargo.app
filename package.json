{
  "name": "horse-cargo-app",
  "version": "1.0.0",
  "private": true,
  "description": "Horse Cargo operating system — web app (www/) + Android APK via Capacitor",
  "scripts": {
    "serve": "npx --yes http-server www -p 8080 -c-1",
    "test:setup": "node test/setup.mjs",
    "test:server": "node test/server.mjs",
    "test:v5": "node test/v5_test.mjs && node test/v5_e2e.mjs",
    "test:updates": "node test/updates_e2e.mjs",
    "web:release": "node scripts/stamp-web-release.mjs",
    "cap:sync": "npx cap sync android",
    "apk:debug": "node scripts/build-apk.mjs debug",
    "apk:release": "node scripts/build-apk.mjs release",
    "apk:bundled": "npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@playwright/test": "^1.63.0",
    "@supabase/supabase-js": "^2.117.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "pg": "^8.23.1"
  }
}
